/*==================== GOOGLE FONTS ====================*/
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap");

/*==================== VARIABLES CSS ====================*/
:root {
  --header-height: 4rem;

  /*========== Colors ==========*/
  --hue-color: 225;

  --accent: hsl(217, 91%, 60%);
  --accent-dark: hsl(217, 91%, 50%);
  --accent-light: hsl(217, 91%, 70%);
  --accent-glow: hsla(217, 91%, 60%, 0.25);

  --first-color: hsl(217, 91%, 60%);
  --first-color-second: hsl(217, 91%, 60%);
  --first-color-alt: hsl(217, 91%, 50%);
  --first-color-lighter: hsl(217, 92%, 88%);

  --title-color: hsl(222, 47%, 11%);
  --text-color: hsl(220, 14%, 40%);
  --text-color-light: hsl(220, 10%, 60%);
  --text-muted: hsl(220, 9%, 70%);

  --input-color: hsl(220, 30%, 96%);
  --body-color: hsl(220, 26%, 97%);
  --container-color: #ffffff;
  --surface-color: hsl(220, 20%, 98%);
  --border-color: hsl(220, 20%, 90%);

  --scroll-bar-color: hsl(220, 12%, 90%);
  --scroll-thumb-color: hsl(220, 12%, 78%);

  /*========== Shadows ==========*/
  --shadow-sm: 0 1px 3px hsla(220, 40%, 10%, 0.06), 0 1px 2px hsla(220, 40%, 10%, 0.04);
  --shadow-md: 0 4px 12px hsla(220, 40%, 10%, 0.08), 0 2px 4px hsla(220, 40%, 10%, 0.04);
  --shadow-lg: 0 12px 32px hsla(220, 40%, 10%, 0.10), 0 4px 8px hsla(220, 40%, 10%, 0.06);
  --shadow-accent: 0 8px 24px hsla(217, 91%, 60%, 0.28);

  /*========== Font and typography ==========*/
  --body-font: "Inter", sans-serif;
  --heading-font: "Space Grotesk", sans-serif;

  --big-font-size: 2.25rem;
  --h1-font-size: 1.75rem;
  --h2-font-size: 1.375rem;
  --h3-font-size: 1.125rem;
  --normal-font-size: 0.9375rem;
  --small-font-size: 0.8125rem;
  --smaller-font-size: 0.75rem;

  /*========== Font weight ==========*/
  --font-light: 300;
  --font-regular: 400;
  --font-medium: 500;
  --font-semi-bold: 600;
  --font-bold: 700;

  /*========== Spacing ==========*/
  --mb-0-25: 0.25rem;
  --mb-0-5: 0.5rem;
  --mb-0-75: 0.75rem;
  --mb-1: 1rem;
  --mb-1-5: 1.5rem;
  --mb-2: 2rem;
  --mb-2-5: 2.5rem;
  --mb-3: 3rem;

  /*========== Border Radius ==========*/
  --radius-sm: 0.375rem;
  --radius-md: 0.625rem;
  --radius-lg: 1rem;
  --radius-xl: 1.5rem;
  --radius-full: 9999px;

  /*========== z index ==========*/
  --z-tooltip: 10;
  --z-fixed: 100;
  --z-modal: 1000;

  /*========== Transitions ==========*/
  --transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-base: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-slow: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Font size for large devices */
@media screen and (min-width: 568px) {
  :root {
    --big-font-size: 2.5rem;
    --h1-font-size: 1.625rem;
    --h2-font-size: 1.375rem;
    --h3-font-size: 1.125rem;
    --normal-font-size: 0.9375rem;
    --small-font-size: 0.8125rem;
    --smaller-font-size: 0.75rem;
  }
}

@media screen and (min-width: 768px) {
  :root {
    --big-font-size: 2.75rem;
    --h1-font-size: 1.875rem;
    --h2-font-size: 1.5rem;
    --h3-font-size: 1.25rem;
    --normal-font-size: 0.9375rem;
    --small-font-size: 0.875rem;
    --smaller-font-size: 0.8125rem;
  }
}

@media screen and (min-width: 968px) {
  :root {
    --big-font-size: 3.25rem;
    --h1-font-size: 2.25rem;
    --h2-font-size: 1.75rem;
    --h3-font-size: 1.25rem;
    --normal-font-size: 1rem;
    --small-font-size: 0.875rem;
    --smaller-font-size: 0.8125rem;
  }
}

/*========== Variables Dark Theme ==========*/
body.dark-theme {
  --first-color-second: hsl(222, 47%, 8%);
  --title-color: hsl(220, 20%, 96%);
  --text-color: hsl(220, 10%, 68%);
  --text-color-light: hsl(220, 10%, 52%);
  --text-muted: hsl(220, 10%, 44%);
  --input-color: hsl(222, 30%, 14%);
  --body-color: hsl(222, 30%, 8%);
  --container-color: hsl(222, 28%, 12%);
  --surface-color: hsl(222, 26%, 10%);
  --border-color: hsl(222, 22%, 18%);
  --scroll-bar-color: hsl(222, 20%, 18%);
  --scroll-thumb-color: hsl(222, 20%, 28%);
  --shadow-sm: 0 1px 3px hsla(0, 0%, 0%, 0.18);
  --shadow-md: 0 4px 12px hsla(0, 0%, 0%, 0.24);
  --shadow-lg: 0 12px 32px hsla(0, 0%, 0%, 0.32);
}

/*========== Theme Toggle Button ==========*/
.nav__btns {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.change-theme {
  font-size: 1.1rem;
  color: var(--text-color);
  cursor: pointer;
  padding: 0.5rem;
  border-radius: var(--radius-md);
  transition: color var(--transition-base), background-color var(--transition-base);
  display: flex;
  align-items: center;
  justify-content: center;
}

.change-theme:hover {
  color: var(--first-color);
  background-color: var(--accent-glow);
}

/*========== Language Toggle ==========*/
.language-toggle {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.8rem;
  color: var(--text-color);
  cursor: pointer;
  padding: 0.4rem 0.6rem;
  border-radius: var(--radius-md);
  background-color: var(--container-color);
  border: 1px solid var(--border-color);
  transition: all var(--transition-base);
  font-family: var(--body-font);
  font-weight: var(--font-medium);
}

.language-toggle:hover {
  color: var(--first-color);
  border-color: var(--first-color);
  background-color: var(--accent-glow);
}

.lang-code {
  font-weight: var(--font-semi-bold);
  letter-spacing: 0.05em;
}

.language-toggle i {
  font-size: 1rem;
}

/*==================== BASE ====================*/
* {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: var(--body-font);
  font-size: var(--normal-font-size);
  background-color: var(--body-color);
  color: var(--text-color);
  line-height: 1.7;
  transition: background-color var(--transition-slow), color var(--transition-slow);
  position: relative;
  overflow-x: hidden;
}

/*==================== BACKGROUND ANIMATIONS ====================*/
#particleCanvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  opacity: 0.6;
}

/* Section z-index untuk konten di atas partikel */
.section {
  position: relative;
  z-index: 1;
  min-height: auto;
}

/* Ensure contact section has higher z-index */
.contact.section {
  z-index: 2;
}

h1, h2, h3, h4 {
  font-family: var(--heading-font);
  color: var(--title-color);
  font-weight: var(--font-semi-bold);
  line-height: 1.25;
}

ul {
  list-style: none;
}

a {
  text-decoration: none;
}

img {
  max-width: 100%;
  height: auto;
}

/*==================== REUSABLE CSS CLASSES ====================*/
.section {
  padding: 5rem 0 3rem;
}

.section__title {
  font-size: var(--h1-font-size);
  font-family: var(--heading-font);
  color: var(--title-color);
  font-weight: var(--font-bold);
  letter-spacing: -0.02em;
  position: relative;
  z-index: 2;
}

.section__subtitle {
  display: block;
  font-size: var(--small-font-size);
  color: var(--first-color);
  font-weight: var(--font-semi-bold);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
  position: relative;
  z-index: 2;
}

.section__title,
.section__subtitle {
  text-align: center;
}

.section__title {
  margin-bottom: var(--mb-3);
}

/*==================== LAYOUT ====================*/
.container {
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

/* Container smooth transitions */
@media screen and (min-width: 768px) {
  .container {
    max-width: 860px;
  }
}

@media screen and (min-width: 900px) {
  .container {
    max-width: 920px;
  }
}

.grid {
  display: grid;
  gap: 1.5rem;
}

/*==================== HEADER ====================*/
.header {
  width: 100%;
  position: fixed;
  top: 0;
  left: 0;
  z-index: var(--z-fixed);
  background-color: transparent;
  transition: background-color var(--transition-base), box-shadow var(--transition-base), backdrop-filter var(--transition-base);
}

.header.scroll-header {
  background-color: hsla(220, 26%, 97%, 0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: var(--shadow-sm);
  border-bottom: 1px solid var(--border-color);
}

body.dark-theme .header.scroll-header {
  background-color: hsla(222, 30%, 8%, 0.88);
}

/* Dark theme canvas opacity */
body.dark-theme #particleCanvas {
  opacity: 0.3;
}

/*==================== NAV ====================*/
.nav {
  max-width: 1024px;
  height: var(--header-height);
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.nav__logo {
  font-family: var(--heading-font);
  font-weight: var(--font-bold);
  font-size: 1.1rem;
  color: var(--title-color);
  letter-spacing: -0.02em;
  transition: color var(--transition-base);
  position: relative;
}

.nav__logo span {
  color: var(--first-color);
}

.nav__logo:hover {
  color: var(--first-color);
}

.nav__toggle {
  color: var(--title-color);
  font-size: 1.5rem;
  cursor: pointer;
  padding: 0.6rem;
  border-radius: var(--radius-md);
  transition: all var(--transition-base);
  background-color: var(--accent-glow);
  border: 1px solid var(--border-color);
}

.nav__toggle:hover {
  color: var(--first-color);
  background-color: var(--first-color);
  border-color: var(--first-color);
  transform: scale(1.05);
}

.nav__toggle i {
  display: block;
  transition: transform var(--transition-base);
}

.nav__toggle:hover i {
  transform: rotate(180deg);
}

@media screen and (max-width: 767px) {
  .nav__menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: hsla(220, 26%, 97%, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 5rem 1.5rem 2rem;
    box-shadow: 0 4px 32px hsla(220, 40%, 10%, 0.12);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 100;
    transform: translateY(-100%);
    overflow-y: auto;
  }

  body.dark-theme .nav__menu {
    background-color: hsla(222, 30%, 8%, 0.98);
  }

  .nav__list {
    grid-template-columns: 1fr;
    gap: 0.75rem;
    max-width: 320px;
    margin: 0 auto;
  }

  .nav__link {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    min-height: 48px;
    font-size: var(--normal-font-size);
    border-radius: var(--radius-md);
    background-color: var(--surface-color);
    border: 1px solid var(--border-color);
    transition: all var(--transition-base);
  }

  .nav__link:hover,
  .nav__link.active-link {
    background-color: var(--accent-glow);
    border-color: var(--first-color);
    transform: translateX(4px);
  }

  .nav__icon {
    font-size: 1.5rem;
  }

  .nav__link:hover .nav__icon,
  .nav__link.active-link .nav__icon {
    transform: scale(1.1);
  }

  /* Fix navigation menu content overlap */
  body:not(.show-menu-open) {
    padding-top: var(--header-height);
  }

  .section {
    padding-top: 4rem;
  }

  /* Contact section mobile fixes - clean version */
  .contact.section {
    padding: 4rem 0 2rem;
    position: relative;
    z-index: 2;
    overflow: visible;
  }

  .contact__container {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .contact__form {
    grid-column: 1;
    padding: 1.5rem;
  }

  .contact__information {
    padding: 1rem;
    flex-direction: row;
  }

  .contact__icon-box {
    width: 2.25rem;
    height: 2.25rem;
  }

  .contact__icon {
    font-size: 1.25rem;
  }

  .contact__inputs {
    grid-template-columns: 1fr;
  }
}

.nav__list {
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem 2rem;
}

.nav__link {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
  font-size: var(--small-font-size);
  color: var(--text-color);
  font-weight: var(--font-medium);
  padding: 0.5rem;
  border-radius: var(--radius-md);
  transition: color var(--transition-base), background-color var(--transition-base);
}

.nav__link:hover,
.nav__link.active-link {
  color: var(--first-color);
}

.nav__icon {
  font-size: 1.25rem;
}

.nav__close {
  position: absolute;
  right: 1.5rem;
  top: 1.25rem;
  font-size: 2rem;
  cursor: pointer;
  color: var(--title-color);
  transition: color var(--transition-base), transform var(--transition-base);
  z-index: 101;
  padding: 0.5rem;
  background-color: var(--accent-glow);
  border-radius: 50%;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav__close:hover {
  color: var(--first-color);
  transform: scale(1.1) rotate(90deg);
}

.show-menu {
  transform: translateY(0) !important;
}

/* Prevent body scroll when menu is open on mobile */
@media screen and (max-width: 767px) {
  body.show-menu-open {
    overflow: hidden;
  }
}

/* Active link */
.active-link {
  color: var(--first-color);
}

/* Active underline indicator (desktop) */
@media screen and (min-width: 768px) {
  .nav__link {
    flex-direction: row;
    gap: 0;
    font-size: var(--normal-font-size);
    padding: 0.4rem 0.75rem;
    position: relative;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 60%;
    height: 2px;
    background-color: var(--first-color);
    border-radius: var(--radius-full);
    transition: transform var(--transition-base);
  }

  .nav__link:hover::after,
  .nav__link.active-link::after {
    transform: translateX(-50%) scaleX(1);
  }
}

/*==================== HOME ====================*/
.home__container {
  gap: 1rem;
}

.home__content {
  grid-template-columns: 0.5fr 3fr;
  padding-top: 5.5rem;
  align-items: center;
}

.home__social {
  display: grid;
  grid-template-columns: max-content;
  row-gap: 1rem;
}

.home__social-icon {
  font-size: 1.25rem;
  color: var(--text-color);
  padding: 0.5rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-color);
  background-color: var(--container-color);
  transition: color var(--transition-base), border-color var(--transition-base),
    box-shadow var(--transition-base), transform var(--transition-base);
  display: flex;
  align-items: center;
  justify-content: center;
}

.home__social-icon:hover {
  color: var(--first-color);
  border-color: var(--first-color);
  box-shadow: var(--shadow-accent);
  transform: translateY(-3px);
}

.home__blob {
  width: 220px;
  fill: var(--first-color);
  filter: drop-shadow(0 8px 24px var(--accent-glow));
}

.home__blob-img {
  width: 175px;
}

.home__img {
  justify-self: center;
  align-self: center;
}

.home__profile-img {
  width: 100%;
  max-width: 280px;
  border-radius: var(--radius-xl);
  box-shadow: 0 12px 32px hsla(217, 91%, 60%, 0.25);
  border: 4px solid var(--container-color);
  transition: transform var(--transition-base), box-shadow var(--transition-base);
}

.home__profile-img:hover {
  transform: translateY(-5px);
  box-shadow: 0 16px 40px hsla(217, 91%, 60%, 0.35);
}

.home__data {
  grid-column: 1/3;
}

.home__greeting {
  font-size: var(--small-font-size);
  color: var(--first-color);
  font-weight: var(--font-semi-bold);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  display: block;
  margin-bottom: 0.5rem;
}

.home_title {
  font-family: var(--heading-font);
  font-size: var(--big-font-size);
  font-weight: var(--font-bold);
  color: var(--title-color);
  letter-spacing: -0.03em;
  line-height: 1.1;
  margin-bottom: 0.75rem;
}

.home__subtitle {
  font-size: var(--h3-font-size);
  color: var(--text-color);
  font-weight: var(--font-medium);
  margin-bottom: 1rem;
  min-height: 2rem;
}

.home__subtitle .auto-input {
  color: var(--first-color);
  font-weight: var(--font-semi-bold);
}

.home__description {
  color: var(--text-color);
  max-width: 480px;
  margin-bottom: var(--mb-2);
  font-size: 0.9375rem;
  line-height: 1.75;
}

.home__actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.home__scroll {
  margin-top: 2rem;
}

.home__scroll-button {
  color: var(--text-color-light);
  transition: color var(--transition-base), transform var(--transition-base);
  font-size: var(--small-font-size);
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}

.home__scroll-button:hover {
  color: var(--first-color);
  transform: translateY(4px);
}

.home__scroll-mouse {
  font-size: 1.5rem;
}

.home__scroll-name {
  font-size: var(--small-font-size);
  font-weight: var(--font-medium);
}

.home__scroll-arrow {
  font-size: 1.1rem;
  animation: bounce 1.5s infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(4px); }
}

/*==================== AVAILABILITY BADGE ====================*/
.availability-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.35rem 0.85rem;
  background-color: hsla(142, 71%, 45%, 0.1);
  border: 1px solid hsla(142, 71%, 45%, 0.3);
  border-radius: var(--radius-full);
  font-size: var(--smaller-font-size);
  font-weight: var(--font-medium);
  color: hsl(142, 60%, 38%);
  margin-bottom: 1rem;
}

body.dark-theme .availability-badge {
  color: hsl(142, 70%, 55%);
  background-color: hsla(142, 71%, 45%, 0.12);
  border-color: hsla(142, 71%, 45%, 0.25);
}

.availability-dot {
  width: 7px;
  height: 7px;
  background-color: hsl(142, 71%, 45%);
  border-radius: 50%;
  animation: pulse-dot 2s infinite;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.8); }
}

/*==================== BUTTONS ====================*/
.button {
  display: inline-block;
  background-color: var(--first-color);
  color: #fff;
  padding: 0.85rem 1.5rem;
  border-radius: var(--radius-md);
  font-weight: var(--font-semi-bold);
  font-size: var(--small-font-size);
  letter-spacing: 0.01em;
  cursor: pointer;
  border: none;
  transition: background-color var(--transition-base), box-shadow var(--transition-base),
    transform var(--transition-fast);
}

.button:hover {
  background-color: var(--first-color-alt);
  box-shadow: var(--shadow-accent);
  transform: translateY(-2px);
}

.button:active {
  transform: translateY(0);
}

.button__icon {
  font-size: 1.1rem;
  margin-left: 0.4rem;
  transition: transform var(--transition-base);
}

.button:hover .button__icon {
  transform: translateX(3px);
}

.button--outline {
  background-color: transparent;
  color: var(--first-color);
  border: 1.5px solid var(--first-color);
}

.button--outline:hover {
  background-color: var(--first-color);
  color: #fff;
  box-shadow: var(--shadow-accent);
}

.button--white {
  background-color: #fff;
  color: var(--first-color);
}

.button--white:hover {
  background-color: #fff;
  box-shadow: 0 8px 24px rgba(255, 255, 255, 0.3);
  transform: translateY(-2px);
}

.button--flex {
  display: inline-flex;
  align-items: center;
}

.button--small {
  padding: 0.65rem 1rem;
  font-size: var(--smaller-font-size);
}

.button--link {
  padding: 0;
  background: transparent;
  color: var(--first-color);
  box-shadow: none;
}

.button--link:hover {
  background-color: transparent;
  color: var(--first-color-alt);
  transform: none;
  box-shadow: none;
}

/*==================== ABOUT ====================*/
.about__img {
  width: 100%;
  max-width: 100%;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  position: relative;
  transition: transform var(--transition-slow), box-shadow var(--transition-slow);
}

.about__img:hover {
  transform: scale(1.02) translateY(-4px);
  box-shadow: 0 20px 48px hsla(220, 40%, 10%, 0.15);
}

.about__description {
  text-align: left;
  margin-bottom: var(--mb-2);
  line-height: 1.8;
  color: var(--text-color);
}

.about_info {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-bottom: var(--mb-2-5);
  justify-items: center;
}

.about__info-card {
  padding: 1rem 0.75rem;
  background-color: var(--container-color);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow-sm);
  text-align: center;
  min-width: 80px;
  width: 100%;
  transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
}

.about__info-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  border-color: var(--first-color);
}

.about__info-title {
  font-family: var(--heading-font);
  font-size: var(--h2-font-size);
  font-weight: var(--font-bold);
  color: var(--first-color);
  display: block;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.about__info-name {
  font-size: var(--smaller-font-size);
  color: var(--text-color-light);
  display: block;
  margin-top: 0.2rem;
  line-height: 1.4;
}

.about__buttons {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

/*==================== SKILLS ====================*/
.skills__container {
  row-gap: 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

/* Mobile skills improvements */
@media screen and (max-width: 567px) {
  .skills__content {
    padding: 1.25rem;
  }

  .skills__header {
    gap: 0.5rem;
  }

  .skills__icon-wrapper {
    width: 2rem;
    height: 2rem;
  }

  .skills__icon {
    font-size: 1.25rem;
  }

  .skills__title {
    font-size: 1rem;
  }

  .skills__subtitle {
    font-size: 0.7rem;
  }

  .skills__bar,
  .skills__percentage {
    height: 4px;
  }

  .skills__percentage::after {
    width: 8px;
    height: 8px;
  }
}

.skills__content {
  background-color: var(--container-color);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  transition: border-color var(--transition-base), box-shadow var(--transition-base);
  overflow: hidden;
}

.skills__content:hover {
  border-color: var(--first-color);
  box-shadow: var(--shadow-md);
}

.skills__header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  cursor: pointer;
  user-select: none;
}

.skills__icon-wrapper {
  width: 2.5rem;
  height: 2.5rem;
  background-color: var(--accent-glow);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.skills__icon {
  font-size: 1.4rem;
  color: var(--first-color);
}

.skills__arrow {
  font-size: 1.25rem;
  color: var(--text-color-light);
  margin-left: auto;
  transition: transform var(--transition-base);
  flex-shrink: 0;
}

.skills__title {
  font-size: var(--h3-font-size);
  font-weight: var(--font-semi-bold);
  color: var(--title-color);
  margin: 0;
}

.skills__subtitle {
  font-size: var(--smaller-font-size);
  color: var(--text-color-light);
  margin-top: 0.15rem;
}

.skills__list {
  padding-top: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

.skills__titles {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.4rem;
}

.skills__name {
  font-size: var(--normal-font-size);
  font-weight: var(--font-medium);
  color: var(--title-color);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.skills__logo {
  border-radius: 4px;
  transition: transform var(--transition-base);
}

.skills__name:hover .skills__logo {
  transform: translateY(-2px);
}

.skills__number {
  font-size: var(--smaller-font-size);
  font-weight: var(--font-semi-bold);
  color: var(--first-color);
}

.skills__bar,
.skills__percentage {
  height: 6px;
  border-radius: var(--radius-full);
}

.skills__bar {
  background-color: var(--input-color);
}

.skills__percentage {
  display: block;
  background: linear-gradient(90deg, var(--first-color), var(--accent-light));
  border-radius: var(--radius-full);
  position: relative;
  transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
}

.skills__percentage::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 10px;
  height: 10px;
  background-color: var(--first-color);
  border-radius: 50%;
  border: 2px solid var(--container-color);
  box-shadow: 0 0 0 2px var(--first-color);
}

/* Skill bar widths */
.skills__html     { width: 90%; }
.skills__css      { width: 85%; }
.skills__js       { width: 75%; }
.skills__react    { width: 70%; }
.skills__tailwinds { width: 80%; }
.skills__php      { width: 85%; }
.skills__mysql    { width: 80%; }
.skills__node     { width: 60%; }
.skills__python   { width: 65%; }
.skills__git      { width: 90%; background: linear-gradient(90deg, #f1502f, #f17f5f); }
.skills__docker   { width: 65%; background: linear-gradient(90deg, #2496ed, #6ab4f5); }
.skills__vscode   { width: 95%; background: linear-gradient(90deg, #007acc, #40a9ff); }

.skills__close .skills__list {
  max-height: 0;
  overflow: hidden;
  padding-top: 0;
  transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.skills__open .skills__list {
  max-height: 800px;
}

.skills__open .skills__arrow {
  transform: rotate(-180deg);
}

/*==================== CERTIFICATES ====================*/
.certificate.section {
  padding: 4rem 0 2rem;
}

/*==================== SERVICES ====================*/
.services__container {
  gap: 1.25rem;
  grid-template-columns: repeat(2, 1fr);
}

.services__content {
  position: relative;
  background-color: var(--container-color);
  padding: 2.5rem 1.5rem 1.5rem;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow-sm);
  transition: border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base);
  overflow: hidden;
}

.services__content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--first-color), var(--accent-light));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform var(--transition-base);
}

.services__content:hover {
  border-color: var(--first-color);
  box-shadow: var(--shadow-lg);
  transform: translateY(-4px);
}

.services__content:hover::before {
  transform: scaleX(1);
}

.services__icon {
  display: block;
  font-size: 2rem;
  color: var(--first-color);
  margin-bottom: var(--mb-1);
}

.services__title {
  font-size: var(--h3-font-size);
  margin-bottom: var(--mb-0-75);
  font-weight: var(--font-semi-bold);
  color: var(--title-color);
}

.services__button {
  cursor: pointer;
  font-size: var(--small-font-size);
  font-weight: var(--font-medium);
}

.services__button:hover .button__icon {
  transform: translateX(4px);
}

.services__modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 1rem;
  z-index: var(--z-modal);
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--transition-base), visibility var(--transition-base);
}

.services__modal-content {
  position: relative;
  background-color: var(--container-color);
  padding: 2rem;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--border-color);
  transform: scale(0.95) translateY(8px);
  transition: transform var(--transition-base);
  max-width: 480px;
  width: 100%;
}

.active-modal .services__modal-content {
  transform: scale(1) translateY(0);
}

.services__modal-services {
  row-gap: 0.9rem;
}

.services__modal-service {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
}

.services__modal-title {
  font-size: var(--h3-font-size);
  font-weight: var(--font-bold);
  margin-bottom: 1.25rem;
  color: var(--title-color);
  padding-right: 2rem;
  line-height: 1.3;
}

.services__modal-close {
  position: absolute;
  top: 1.25rem;
  right: 1.25rem;
  font-size: 1.5rem;
  color: var(--text-color-light);
  cursor: pointer;
  transition: color var(--transition-base);
  line-height: 1;
}

.services__modal-close:hover {
  color: var(--title-color);
}

.services__modal-icon {
  color: var(--first-color);
  flex-shrink: 0;
  margin-top: 0.15rem;
}

.active-modal {
  opacity: 1;
  visibility: visible;
}

/*==================== PORTFOLIO ====================*/
.portfolio__container {
  overflow: initial;
}

.portfolio__content {
  padding: 0 1.5rem 2rem;
}

.portfolio__img {
  width: 100%;
  max-width: 300px;
  border-radius: var(--radius-lg);
  justify-self: center;
  box-shadow: var(--shadow-md);
  transition: transform var(--transition-slow), box-shadow var(--transition-slow);
}

.portfolio__img:hover {
  transform: scale(1.03) translateY(-4px);
  box-shadow: var(--shadow-lg);
}

.portfolio__title {
  font-size: var(--h3-font-size);
  font-weight: var(--font-semi-bold);
  margin-bottom: var(--mb-0-5);
  color: var(--title-color);
}

.portfolio__tech-stack {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-bottom: var(--mb-0-75);
}

.portfolio__tech {
  font-size: var(--smaller-font-size);
  color: var(--first-color);
  background-color: var(--accent-glow);
  padding: 0.2rem 0.6rem;
  border-radius: var(--radius-full);
  font-weight: var(--font-medium);
  border: 1px solid hsla(217, 91%, 60%, 0.2);
}

.portfolio__description {
  margin-bottom: var(--mb-1);
  font-size: var(--small-font-size);
  line-height: 1.7;
  color: var(--text-color);
}

.portfolio__button:hover .button__icon {
  transform: translateX(4px);
}

.swiper-button-prev::after,
.swiper-button-next::after {
  content: "";
}

.swiper-portfolio-icon {
  font-size: 2rem;
  color: var(--first-color);
}

.swiper-button-prev {
  left: -0.5rem;
}

.swiper-button-next {
  right: -0.5rem;
}

/* Mobile swiper controls */
@media screen and (max-width: 767px) {
  .swiper-button-prev,
  .swiper-button-next {
    width: 40px;
    height: 40px;
    top: 50%;
    transform: translateY(-50%);
  }

  .swiper-button-prev {
    left: 0.5rem;
  }

  .swiper-button-next {
    right: 0.5rem;
  }

  .swiper-portfolio-icon {
    font-size: 1.5rem;
  }

  .swiper-pagination-bullet {
    width: 8px;
    height: 8px;
  }
}

.swiper-container-horizontal > .swiper-pagination-bullets {
  bottom: -0.5rem;
}

.swiper-pagination-bullet-active {
  background-color: var(--first-color);
}

.swiper-button-prev,
.swiper-button-next,
.swiper-pagination-bullet {
  outline: none;
}

/*==================== CTA SECTION ====================*/
.project {
  text-align: center;
}

.project__bg {
  background: linear-gradient(135deg, var(--first-color) 0%, hsl(197, 91%, 50%) 100%);
  padding-top: 3rem;
  border-radius: var(--radius-xl);
  position: relative;
  overflow: hidden;
}

.project__bg::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, hsla(0, 0%, 100%, 0.08) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.project__container {
  position: relative;
  z-index: 1;
}

.project__title {
  font-size: var(--h2-font-size);
  margin-bottom: var(--mb-0-75);
  font-weight: var(--font-bold);
  letter-spacing: -0.02em;
}

.project__description {
  margin-bottom: var(--mb-1-5);
  font-size: var(--normal-font-size);
  opacity: 0.9;
}

.project__title,
.project__description {
  color: #fff;
}

.project__img {
  width: 232px;
  justify-self: center;
}

/*==================== TESTIMONIAL ====================*/
.testimonial__data,
.testimonial__header {
  display: flex;
}

.testimonial__data {
  justify-content: space-between;
  margin-bottom: var(--mb-1);
}

.testimonial__content {
  background-color: var(--container-color);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 1.75rem;
  box-shadow: var(--shadow-sm);
  position: relative;
}

.testimonial__content::before {
  content: '"';
  font-family: var(--heading-font);
  font-size: 5rem;
  color: var(--first-color);
  opacity: 0.15;
  position: absolute;
  top: 0.5rem;
  left: 1.25rem;
  line-height: 1;
  pointer-events: none;
}

.testimonial_img {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  margin-right: var(--mb-0-75);
  background-color: var(--accent-glow);
  border: 2px solid var(--first-color);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.testimonial__name {
  font-size: var(--h3-font-size);
  font-weight: var(--font-semi-bold);
  color: var(--title-color);
}

.testimonial__client {
  font-size: var(--smaller-font-size);
  color: var(--first-color);
  font-weight: var(--font-medium);
}

.testimonial__description {
  margin-bottom: 0;
  font-style: italic;
  line-height: 1.75;
  color: var(--text-color);
  position: relative;
  z-index: 1;
}

.star-rating {
  display: flex;
  gap: 0.2rem;
  margin-bottom: var(--mb-1);
}

.star-rating span {
  color: hsl(45, 96%, 55%);
  font-size: 1rem;
}

.swiper-container .swiper-pagination-testimonial {
  bottom: 0;
}

/*==================== CONTACT ME ====================*/
.contact__container {
  row-gap: 2.5rem;
  position: relative;
  z-index: 2;
  display: grid;
}

/* Contact section visibility */
.contact {
  display: block;
  visibility: visible;
  position: relative;
  height: auto;
  min-height: auto;
}

.contact__info-wrapper {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.contact__information {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  padding: 1.25rem;
  background-color: var(--container-color);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  transition: border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base);
  text-decoration: none;
  position: relative;
  z-index: 2;
}

.contact__information:hover {
  border-color: var(--first-color);
  box-shadow: var(--shadow-md);
  transform: translateX(4px);
}

.contact__icon-box {
  width: 2.75rem;
  height: 2.75rem;
  background-color: var(--accent-glow);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.contact__icon {
  font-size: 1.4rem;
  color: var(--first-color);
}

.contact__title {
  font-size: var(--small-font-size);
  font-weight: var(--font-semi-bold);
  color: var(--title-color);
  margin-bottom: 0.15rem;
}

.contact__subtitle {
  font-size: var(--smaller-font-size);
  color: var(--text-color-light);
  word-break: break-all;
}

.contact__form {
  background-color: var(--container-color);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-xl);
  padding: 2rem;
  box-shadow: var(--shadow-sm);
  position: relative;
  z-index: 2;
  overflow: visible;
}

.contact__content {
  background-color: var(--surface-color);
  border: 1.5px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 0.875rem 1rem 0.625rem;
  transition: border-color var(--transition-base), box-shadow var(--transition-base);
}

.contact__content:focus-within {
  border-color: var(--first-color);
  box-shadow: 0 0 0 3px var(--accent-glow);
}

.contact__label {
  font-size: var(--smaller-font-size);
  color: var(--text-color-light);
  font-weight: var(--font-medium);
  display: block;
  margin-bottom: 0.25rem;
}

.contact__input {
  width: 100%;
  background-color: transparent;
  color: var(--title-color);
  font-family: var(--body-font);
  font-size: var(--normal-font-size);
  border: none;
  outline: none;
  min-height: 48px;
  padding: 0.5rem 0;
}

.contact__input[type="textarea"],
.contact__input textarea {
  min-height: 120px;
  resize: vertical;
}

.contact__input::placeholder {
  color: var(--text-muted);
  font-size: var(--small-font-size);
}

/*==================== FOOTER ====================*/
.footer {
  padding-top: 0;
}

.footer__bg {
  background: linear-gradient(135deg, hsl(222, 47%, 11%) 0%, hsl(217, 50%, 18%) 100%);
  padding: 2.5rem 1.5rem;
}

.footer__copy {
  font-size: var(--smaller-font-size);
  text-align: center;
  color: hsla(220, 20%, 80%, 0.7);
  margin: 0;
}

.footer__copy strong {
  color: var(--first-color);
}

/*========== SCROLL UP ==========*/
.scrollup {
  position: fixed;
  right: 1.25rem;
  bottom: -20%;
  background-color: var(--first-color);
  padding: 0.45rem 0.5rem;
  border-radius: var(--radius-md);
  z-index: var(--z-tooltip);
  transition: bottom 0.4s cubic-bezier(0.4, 0, 0.2, 1), box-shadow var(--transition-base), transform var(--transition-base);
  box-shadow: var(--shadow-accent);
  display: flex;
  align-items: center;
  justify-content: center;
}

.scrollup:hover {
  background-color: var(--first-color-alt);
  transform: translateY(-3px);
}

.scrollup__icon {
  font-size: 1.4rem;
  color: #fff;
}

.show-scroll {
  bottom: 1.5rem;
}

/*========== SCROLL BAR ==========*/
::-webkit-scrollbar {
  width: 8px;
  background-color: var(--scroll-bar-color);
}

::-webkit-scrollbar-thumb {
  background-color: var(--scroll-thumb-color);
  border-radius: var(--radius-full);
}

::-webkit-scrollbar-thumb:hover {
  background-color: var(--text-color-light);
}

/*==================== TIMELINE (EXPERIENCE & EDUCATION) ====================*/
.timeline-item {
  transition: transform var(--transition-base), padding-left var(--transition-base);
}

.timeline-item:hover {
  transform: translateX(4px);
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: -7px;
  top: 0;
  width: 12px;
  height: 12px;
  background: var(--first-color);
  border-radius: 50%;
  box-shadow: 0 0 0 4px var(--accent-glow);
  transition: transform var(--transition-base), background-color var(--transition-base);
}

.timeline-item:hover::before {
  transform: scale(1.2);
  background-color: var(--first-color-alt);
}

/*==================== WAVE ANIMATION ====================*/
.wave {
  animation-name: wave-animation;
  animation-duration: 2.5s;
  animation-iteration-count: infinite;
  transform-origin: 70% 70%;
  display: inline-block;
}

@keyframes wave-animation {
  0%   { transform: rotate(0deg); }
  10%  { transform: rotate(14deg); }
  20%  { transform: rotate(-8deg); }
  30%  { transform: rotate(14deg); }
  40%  { transform: rotate(-4deg); }
  50%  { transform: rotate(10deg); }
  60%  { transform: rotate(0deg); }
  100% { transform: rotate(0deg); }
}

/*==================== FADE IN ANIMATION ====================*/
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

.fade-in-up {
  animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

/*==================== MEDIA QUERIES ====================*/
/* For very small devices (iPhone SE, older Android) */
@media screen and (max-width: 350px) {
  .container {
    padding-left: 1rem;
    padding-right: 1rem;
    max-width: 100%;
  }

  :root {
    --big-font-size: 1.75rem;
    --h1-font-size: 1.5rem;
    --h2-font-size: 1.125rem;
    --h3-font-size: 1rem;
    --normal-font-size: 0.875rem;
    --small-font-size: 0.75rem;
    --smaller-font-size: 0.6875rem;
  }

  .nav__menu {
    padding: 4rem 1rem 2rem;
  }

  .nav__list {
    max-width: 100%;
    gap: 0.5rem;
  }

  .nav__link {
    padding: 0.75rem 0.875rem;
    font-size: var(--small-font-size);
  }

  .nav__icon {
    font-size: 1.125rem;
  }

  .home__content {
    grid-template-columns: 0.25fr 3fr;
  }

  .home__blob {
    width: 160px;
  }

  .home__profile-img {
    max-width: 160px;
  }

  .home_title {
    font-size: 1.5rem;
  }

  .about_info {
    grid-template-columns: repeat(3, 1fr);
    gap: 0.25rem;
  }

  .about__info-card {
    min-width: 60px;
    padding: 0.5rem 0.25rem;
  }

  .about__info-title {
    font-size: 1rem;
  }

  .about__info-name {
    font-size: 0.625rem;
  }

  .skills__title {
    font-size: var(--normal-font-size);
  }

  .services__container {
    grid-template-columns: 1fr;
  }

  .contact__information {
    padding: 0.875rem;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact__icon-box {
    width: 2rem;
    height: 2rem;
  }

  .contact__icon {
    font-size: 1.125rem;
  }

  .contact__form {
    padding: 1rem;
  }

  .contact__input {
    min-height: 44px;
  }

  .button {
    padding: 0.75rem 1.25rem;
  }

  .nav__close {
    width: 40px;
    height: 40px;
    font-size: 1.25rem;
  }

  /* Ensure contact section is visible on very small devices */
  .contact.section {
    position: relative;
    z-index: 2;
    min-height: auto;
    padding: 3rem 0 1.5rem;
    display: block;
    visibility: visible;
  }

  .contact__container {
    grid-template-columns: 1fr;
    row-gap: 1.5rem;
    display: grid;
  }

  .contact__form {
    grid-column: 1;
    display: block;
  }
}

/* For small devices */
@media screen and (max-width: 400px) {
  .container {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .nav__menu {
    padding: 5rem 1rem 2rem;
  }

  .nav__list {
    max-width: 100%;
    gap: 0.5rem;
  }

  .nav__link {
    padding: 0.875rem 1rem;
    font-size: var(--small-font-size);
  }

  .nav__icon {
    font-size: 1.25rem;
  }

  .home__content {
    grid-template-columns: 0.25fr 3fr;
  }

  .home__blob {
    width: 180px;
  }

  .home__profile-img {
    max-width: 200px;
  }

  .skills__title {
    font-size: var(--normal-font-size);
  }

  .services__container {
    grid-template-columns: 1fr;
  }

  .project__img {
    width: 200px;
  }

  .about_info {
    flex-direction: column;
    align-items: flex-start;
  }

  .nav__close {
    width: 42px;
    height: 42px;
    font-size: 1.5rem;
  }

  /* About info cards - 3 column grid for mobile */
  .about_info {
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .about__info-card {
    min-width: 70px;
    padding: 0.75rem 0.5rem;
  }

  .about__info-title {
    font-size: 1.25rem;
  }

  .about__info-name {
    font-size: 0.65rem;
    line-height: 1.3;
  }
}

  /* Ensure contact section is visible on mobile */
  .contact.section {
    position: relative;
    z-index: 2;
    min-height: auto;
    padding: 4rem 0 2rem;
    display: block;
    visibility: visible;
  }

  .contact__container {
    grid-template-columns: 1fr;
    row-gap: 2rem;
    display: grid;
  }

  .contact__form {
    grid-column: 1;
    display: block;
  }

  /* Contact section elements visibility */
  .contact__title,
  .contact__subtitle {
    display: block;
    visibility: visible;
  }
}

/* For medium devices */
@media screen and (min-width: 568px) {
  .home__content {
    grid-template-columns: max-content 1fr 1fr;
  }

  .home__data {
    grid-column: initial;
  }

  .home__img {
    order: 1;
    justify-self: center;
  }

  .about__container,
  .skills__container,
  .portfolio__content,
  .project__container,
  .contact__container,
  .footer__container {
    grid-template-columns: repeat(2, 1fr);
  }

  .contact__form {
    grid-column: span 2;
  }
}

@media screen and (min-width: 768px) {
  body {
    margin: 0;
  }

  .section {
    padding: 7rem 0 3rem;
  }

  .header {
    top: 0;
    bottom: initial;
  }

  .nav {
    height: calc(var(--header-height) + 0.5rem);
  }

  .nav__icon,
  .nav__close,
  .nav__toggle {
    display: none;
  }

  .nav__list {
    display: flex;
    column-gap: 0.25rem;
  }

  .nav__menu {
    margin-left: auto;
  }

  .change-theme {
    margin: 0;
  }

  .home__container {
    row-gap: 5rem;
  }

  .home__content {
    padding-top: 5.5rem;
    column-gap: 2rem;
  }

  .home__blob {
    padding-top: 2rem;
  }

  .home__scroll-button {
    margin-left: 3rem;
  }

  .about__container {
    column-gap: 5rem;
  }

  .about__img {
    width: 320px;
  }

  .about__description {
    text-align: left;
  }

  .about__buttons {
    justify-content: initial;
  }

  .services__container {
    grid-template-columns: repeat(2, 1fr);
    justify-content: center;
  }

  .services__icon {
    font-size: 2.25rem;
  }

  .services__content {
    padding: 3rem 1.75rem 1.75rem;
  }

  .services__modal-content {
    width: 480px;
  }

  .portfolio__img {
    max-width: 360px;
  }

  .portfolio__content {
    align-items: center;
  }

  .project {
    text-align: initial;
  }

  .project__bg {
    background: linear-gradient(135deg, var(--first-color) 0%, hsl(197, 91%, 50%) 100%);
    border-radius: var(--radius-xl);
  }

  .project__container {
    padding: 3rem 2.5rem 0;
    grid-template-columns: 1fr max-content;
    column-gap: 3rem;
    border-radius: var(--radius-xl);
  }

  .project__data {
    padding-top: 0.8rem;
  }

  .footer__bg {
    padding: 3rem 0 3.5rem;
  }

  .footer__copy {
    margin-top: 3rem;
  }

  .contact__form {
    grid-column: initial;
  }
}

@media screen and (min-width: 1024px) {
  .container {
    max-width: 960px;
  }
}

@media screen and (min-width: 1200px) {
  .container {
    max-width: 1100px;
  }
}

  .home__blob {
    width: 340px;
  }

  .home__social {
    transform: translateX(-6rem);
  }

  .services__container {
    grid-template-columns: repeat(2, 320px);
    justify-content: center;
  }

  .portfolio__content {
    column-gap: 5rem;
  }

  .swiper-portfolio-icon {
    font-size: 3.5rem;
  }

  .swiper-button-prev {
    left: -3.5rem;
  }

  .swiper-button-next {
    right: -3.5rem;
  }

  .swiper-container-horizontal > .swiper-pagination-bullets {
    bottom: -4.5rem;
  }

  .contact__inputs {
    grid-template-columns: repeat(2, 1fr);
  }
}

/*==================== SELECTION ====================*/
::selection {
  background-color: var(--accent-glow);
  color: var(--first-color);
}
